import Std

/-!
# Unit-time scheduling with an eager in-order-retirement ROB

This module uses Lean's bundled Std library only. Jobs are zero-based `Fin n`.
Issue time `c` means completion at the end of cycle `c`, usable in cycle `c+1`.
The canonical retirement prefix at the start of `c` is the first job whose
issue time is not strictly below `c`, or `n` when every job is complete.

There are no claims here about algebraic program rewrites, register allocation,
real processor pipelines, the Python implementation, or an online scheduler.
-/

namespace ILP1

abbrev TimeAssignment (n : Nat) := Fin n → Nat
abbrev Dependency (n : Nat) := Fin n → Fin n → Prop

/-- True data-dependence edges respect the source program order. -/
def Forward {n : Nat} (dep : Dependency n) : Prop :=
  ∀ i j, dep i j → i.val < j.val

def Respects {n : Nat} (dep : Dependency n) (t : TimeAssignment n) : Prop :=
  ∀ i j, dep i j → t i < t j

/-- `r` is exactly the number of jobs retired before cycle `c`. -/
def RetirementPrefix {n : Nat} (t : TimeAssignment n) (c r : Nat) : Prop :=
  r ≤ n ∧
  (∀ i : Fin n, i.val < r → t i < c) ∧
  (∀ h : r < n, c ≤ t ⟨r, h⟩)

/-- A finite natural-number minimization lemma; no computability is claimed. -/
theorem exists_least_nat (p : Nat → Prop) (hp : ∃ k, p k) :
    ∃ k, p k ∧ ∀ j, p j → k ≤ j := by
  classical
  have aux : ∀ k, p k → ∃ m, p m ∧ ∀ j, p j → m ≤ j := by
    intro k
    induction k using Nat.strongRecOn with
    | ind k ih =>
      intro hk
      by_cases hsmall : ∃ j, j < k ∧ p j
      · obtain ⟨j, hjk, hj⟩ := hsmall
        exact ih j hjk hj
      · refine ⟨k, hk, ?_⟩
        intro j hj
        apply Classical.byContradiction
        intro hkj
        exact hsmall ⟨j, by omega, hj⟩
  obtain ⟨k, hk⟩ := hp
  exact aux k hk

theorem retirementPrefix_exists {n : Nat} (t : TimeAssignment n) (c : Nat) :
    ∃ r, RetirementPrefix t c r := by
  classical
  let p : Nat → Prop := fun r => n ≤ r ∨ ∃ h : r < n, c ≤ t ⟨r, h⟩
  have hn : p n := Or.inl (Nat.le_refl n)
  obtain ⟨r, hr, hmin⟩ := exists_least_nat p ⟨n, hn⟩
  have hrn : r ≤ n := hmin n hn
  refine ⟨r, hrn, ?_, ?_⟩
  · intro i hir
    apply Classical.byContradiction
    intro htic
    have hi : p i.val := Or.inr ⟨i.isLt, by change c ≤ t i; omega⟩
    have := hmin i.val hi
    omega
  · intro hrlt
    rcases hr with hnr | ⟨h, hc⟩
    · omega
    · exact hc

theorem retirementPrefix_unique {n : Nat} {t : TimeAssignment n} {c r s : Nat}
    (hr : RetirementPrefix t c r) (hs : RetirementPrefix t c s) : r = s := by
  rcases hr with ⟨hrn, hrd, hru⟩
  rcases hs with ⟨hsn, hsd, hsu⟩
  by_cases hrs : r < s
  · have hrlt : r < n := by omega
    have hdone := hsd ⟨r, hrlt⟩ hrs
    have hundone := hru hrlt
    omega
  · by_cases hsr : s < r
    · have hslt : s < n := by omega
      have hdone := hrd ⟨s, hslt⟩ hsr
      have hundone := hsu hslt
      omega
    · omega

theorem retirementPrefix_mono {n : Nat} {t : TimeAssignment n}
    {c d r s : Nat} (hcd : c ≤ d)
    (hr : RetirementPrefix t c r) (hs : RetirementPrefix t d s) : r ≤ s := by
  rcases hr with ⟨hrn, hrd, hru⟩
  rcases hs with ⟨hsn, hsd, hsu⟩
  apply Classical.byContradiction
  intro hrs
  have hsr : s < r := by omega
  have hslt : s < n := by omega
  have hdone := hrd ⟨s, hslt⟩ hsr
  have hundone := hsu hslt
  omega

/-- A job issuing in cycle `c` has not already retired before that cycle. -/
theorem not_retired_at_issue {n : Nat} {t : TimeAssignment n} (j : Fin n)
    {r : Nat} (hr : RetirementPrefix t (t j) r) : r ≤ j.val := by
  apply Classical.byContradiction
  intro h
  have hdone := hr.2.1 j (by omega)
  omega

/-- The additional precedence constraints generated by window capacity `b`. -/
def WindowEdges {n : Nat} (t : TimeAssignment n) (b : Nat) : Prop :=
  ∀ i j : Fin n, i.val + b ≤ j.val → t i < t j

/-- At issue time each job belongs to the canonical eager ROB interval.

The upper endpoint is implicitly capped by `n`, since jobs have type `Fin n`.
Completed jobs blocked from retirement remain in this interval.
-/
def CanonicalROB {n : Nat} (t : TimeAssignment n) (b : Nat) : Prop :=
  ∀ j : Fin n, ∀ r, RetirementPrefix t (t j) r →
    r ≤ j.val ∧ j.val < r + b

theorem windowEdges_iff_canonicalROB {n : Nat} (t : TimeAssignment n) (b : Nat) :
    WindowEdges t b ↔ CanonicalROB t b := by
  constructor
  · intro he j r hr
    have hrj := not_retired_at_issue j hr
    refine ⟨hrj, ?_⟩
    apply Classical.byContradiction
    intro hupper
    have hrn : r < n := Nat.lt_of_le_of_lt hrj j.isLt
    have hblock := hr.2.2 hrn
    have hearly := he ⟨r, hrn⟩ j (by change r + b ≤ j.val; omega)
    omega
  · intro hw i j hij
    obtain ⟨r, hr⟩ := retirementPrefix_exists t (t j)
    have hwindow := hw j r hr
    exact hr.2.1 i (by omega)

/-- Contrapositive form: every older unfinished job is less than `b` positions
behind the issuing job. This yields a fixed-schedule resource certificate. -/
theorem windowEdges_iff_blockingDistance {n : Nat} (t : TimeAssignment n) (b : Nat) :
    WindowEdges t b ↔
      ∀ i j : Fin n, t j ≤ t i → j.val < i.val + b := by
  constructor
  · intro h i j ht
    apply Classical.byContradiction
    intro hdist
    have := h i j (by omega)
    omega
  · intro h i j hdist
    apply Classical.byContradiction
    intro ht
    have := h i j (by omega)
    omega

def AugmentedDependency {n : Nat} (dep : Dependency n) (b : Nat) : Dependency n :=
  fun i j => dep i j ∨ i.val + b ≤ j.val

theorem augmented_iff {n : Nat} (dep : Dependency n) (t : TimeAssignment n) (b : Nat) :
    Respects (AugmentedDependency dep b) t ↔
      Respects dep t ∧ CanonicalROB t b := by
  rw [← windowEdges_iff_canonicalROB]
  constructor
  · intro h
    exact ⟨fun i j hd => h i j (Or.inl hd), fun i j hb => h i j (Or.inr hb)⟩
  · rintro ⟨hd, hb⟩ i j (hij | hij)
    · exact hd i j hij
    · exact hb i j hij

theorem augmented_forward {n : Nat} {dep : Dependency n} (hd : Forward dep)
    {b : Nat} (hb : 0 < b) : Forward (AugmentedDependency dep b) := by
  intro i j hij
  rcases hij with hij | hij
  · exact hd i j hij
  · omega

/-- Exact issue capacity expressed as a lane assignment. No two jobs may use
the same lane in the same cycle. Lane identities impose no other constraints. -/
def WidthBound {n : Nat} (t : TimeAssignment n) (w : Nat) : Prop :=
  ∃ lane : Fin n → Nat,
    (∀ i, lane i < w) ∧
    (∀ i j, t i = t j → lane i = lane j → i = j)

def Legal {n : Nat} (dep : Dependency n) (b w : Nat) (t : TimeAssignment n) : Prop :=
  Respects dep t ∧ CanonicalROB t b ∧ WidthBound t w

def Feasible {n : Nat} (dep : Dependency n) (b w k : Nat) : Prop :=
  ∃ t : TimeAssignment n, Legal dep b w t ∧ ∀ i, t i < k

def Optimal {n : Nat} (dep : Dependency n) (b w k : Nat) : Prop :=
  Feasible dep b w k ∧ ∀ l, Feasible dep b w l → k ≤ l

theorem window_mono {n : Nat} {t : TimeAssignment n} {b b' : Nat}
    (hbb : b ≤ b') (h : CanonicalROB t b) : CanonicalROB t b' := by
  intro j r hr
  have := h j r hr
  omega

theorem width_mono {n : Nat} {t : TimeAssignment n} {w w' : Nat}
    (hww : w ≤ w') (h : WidthBound t w) : WidthBound t w' := by
  obtain ⟨lane, hl, hi⟩ := h
  exact ⟨lane, fun i => Nat.lt_of_lt_of_le (hl i) hww, hi⟩

theorem feasible_resources_mono {n : Nat} {dep : Dependency n}
    {b b' w w' k : Nat} (hbb : b ≤ b') (hww : w ≤ w')
    (h : Feasible dep b w k) : Feasible dep b' w' k := by
  obtain ⟨t, ⟨hd, hb, hw⟩, hk⟩ := h
  exact ⟨t, ⟨hd, window_mono hbb hb, width_mono hww hw⟩, hk⟩

theorem feasible_horizon_mono {n : Nat} {dep : Dependency n}
    {b w k l : Nat} (hkl : k ≤ l) (h : Feasible dep b w k) : Feasible dep b w l := by
  obtain ⟨t, hlegal, hk⟩ := h
  exact ⟨t, hlegal, fun i => Nat.lt_of_lt_of_le (hk i) hkl⟩

def serial (n : Nat) : TimeAssignment n := fun i => i.val

theorem serial_legal {n : Nat} {dep : Dependency n} (hd : Forward dep)
    {b w : Nat} (hb : 0 < b) (hw : 0 < w) : Legal dep b w (serial n) := by
  refine ⟨hd, ?_, ?_⟩
  · apply (windowEdges_iff_canonicalROB (serial n) b).1
    intro i j hij
    simp only [serial]
    omega
  · refine ⟨fun _ => 0, fun _ => hw, ?_⟩
    intro i j ht _
    exact Fin.ext ht

theorem feasible_serial {n : Nat} {dep : Dependency n} (hd : Forward dep)
    {b w : Nat} (hb : 0 < b) (hw : 0 < w) : Feasible dep b w n := by
  exact ⟨serial n, serial_legal hd hb hw, fun i => i.isLt⟩

theorem optimal_exists {n : Nat} {dep : Dependency n} (hd : Forward dep)
    {b w : Nat} (hb : 0 < b) (hw : 0 < w) :
    ∃ k, Optimal dep b w k ∧ k ≤ n := by
  obtain ⟨k, hk, hmin⟩ :=
    exists_least_nat (Feasible dep b w) ⟨n, feasible_serial hd hb hw⟩
  exact ⟨k, ⟨hk, hmin⟩, hmin n (feasible_serial hd hb hw)⟩

theorem optimal_unique {n : Nat} {dep : Dependency n} {b w k l : Nat}
    (hk : Optimal dep b w k) (hl : Optimal dep b w l) : k = l := by
  have hkl := hk.2 l hl.1
  have hlk := hl.2 k hk.1
  omega

/-- A witness plus exclusion of every shorter horizon is an exact certificate.
This theorem does not claim that finding the exclusion proof is efficient. -/
theorem optimal_iff_certificate {n : Nat} (dep : Dependency n) (b w k : Nat) :
    Optimal dep b w k ↔
      Feasible dep b w k ∧ ∀ l, l < k → ¬ Feasible dep b w l := by
  constructor
  · rintro ⟨hk, hmin⟩
    refine ⟨hk, ?_⟩
    intro l hl hf
    have := hmin l hf
    omega
  · rintro ⟨hk, hshort⟩
    refine ⟨hk, ?_⟩
    intro l hl
    apply Classical.byContradiction
    intro hkl
    exact hshort l (by omega) hl

/-- By feasibility monotonicity, one excluded predecessor horizon suffices. -/
theorem optimal_iff_previous_infeasible {n : Nat} (dep : Dependency n)
    (b w k : Nat) (hk : 0 < k) :
    Optimal dep b w k ↔ Feasible dep b w k ∧ ¬ Feasible dep b w (k - 1) := by
  rw [optimal_iff_certificate]
  constructor
  · rintro ⟨hf, hshort⟩
    exact ⟨hf, hshort (k - 1) (by omega)⟩
  · rintro ⟨hf, hprev⟩
    refine ⟨hf, ?_⟩
    intro l hl hfl
    exact hprev (feasible_horizon_mono (by omega) hfl)

theorem optimal_resources_antitone {n : Nat} {dep : Dependency n}
    {b b' w w' k k' : Nat} (hbb : b ≤ b') (hww : w ≤ w')
    (hk : Optimal dep b w k) (hk' : Optimal dep b' w' k') : k' ≤ k := by
  exact hk'.2 k (feasible_resources_mono hbb hww hk.1)

theorem empty_optimal (dep : Dependency 0) (b w : Nat) : Optimal dep b w 0 := by
  refine ⟨?_, fun k _ => Nat.zero_le k⟩
  refine ⟨fun i => Fin.elim0 i, ?_, fun i => Fin.elim0 i⟩
  refine ⟨?_, ?_, ?_⟩
  · intro i
    exact Fin.elim0 i
  · intro i
    exact Fin.elim0 i
  · exact ⟨fun i => Fin.elim0 i, fun i => Fin.elim0 i,
      fun i => Fin.elim0 i⟩

theorem nonempty_positive_horizon {n : Nat} {dep : Dependency n} (hn : 0 < n)
    {b w k : Nat} (h : Feasible dep b w k) : 0 < k := by
  obtain ⟨t, _, hk⟩ := h
  have := hk ⟨0, hn⟩
  omega

